[user]
    name = Miklós Tusz
    email = mdtusz@gmail.com
[commit]
	gpgsign = false
[github]
    user = mdtusz
[push]
    default = simple
[pull]
	ff = only
[color]
    ui = auto
    diff = auto
    status = auto
    branch = auto
[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green
[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red
    new = green
[color "status"]
    added = yellow
    changed = green
    untracked = cyan
[advice]
    statusHints = true
[core]
    editor = hx
	pager = delta
[alias]
    co = checkout
    psu = push --set-upstream
    reabse = rebase
    hist = log --graph --decorate --oneline
    tree = log --all --graph --decorate --oneline
    merges = log --graph --decorate --oneline --merges
    b = "!zsh -c 'source $HOME/.config/zsh/functions.zsh && branch-info'"
    sshow = "!f() { git stash show -u -p stash@{${1:-0}}; }; f"
    sync = "!zsh -c 'git checkout master && git pull -p'"
[pager]
    branch = false
[status]
    submoduleSummary = true
    showStash = true
[filter "lfs"]
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f
[init]
	defaultBranch = master
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	dark = true
[rebase]
    updateRefs = true
[credential "https://github.com"]
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = !gh auth git-credential

[includeIf "gitdir:**/aon3d/**"]
    path = aon3d.config
